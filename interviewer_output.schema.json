{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewerResponse HTTP contract v2",
  "oneOf": [
    {
      "$ref": "#/$defs/InterviewerResponse"
    },
    {
      "$ref": "#/$defs/InterviewerErrorResponse"
    }
  ],
  "$defs": {
    "MLResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Tokens"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completion Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
