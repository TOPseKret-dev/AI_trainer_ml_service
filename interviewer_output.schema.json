    "MLErrorBody_Literal__interviewer___": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/MLErrorCode"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/MLErrorDetails_Literal__interviewer___"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MLErrorBody[Literal['interviewer']]",
      "type": "object"
    },
    "MLErrorCode": {
      "enum": [
        "ML_INVALID_INPUT",
        "ML_NOTHING_TO_EVALUATE",
        "ML_PROVIDER_NOT_CONFIGURED",
        "ML_PROVIDER_AUTH_ERROR",
        "ML_PROVIDER_QUOTA_EXCEEDED",
        "ML_PROVIDER_CONFIG_ERROR",
        "ML_RATE_LIMITED",
        "ML_UNAVAILABLE",
        "ML_QUEUE_FULL",
        "ML_TIMEOUT",
        "ML_QUEUE_TIMEOUT",
        "ML_EMPTY_RESPONSE",
        "ML_OUTPUT_TRUNCATED",
        "ML_SCHEMA_ERROR",
        "ML_INVALID_RESPONSE",
        "ML_POLICY_REFUSAL",
        "ML_INTERNAL_ERROR"
      ],
      "title": "MLErrorCode",
      "type": "string"
    },
    "MLErrorDetails_Literal__interviewer___": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "interviewer",
