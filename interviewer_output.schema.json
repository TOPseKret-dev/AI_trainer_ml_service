            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "action": {
              "const": "complete"
            },
            "message": {
              "type": "null"
            }
          }
        }
      ],
      "properties": {
        "action": {
          "enum": [
            "follow_up",
            "complete"
          ],
          "title": "Action",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
