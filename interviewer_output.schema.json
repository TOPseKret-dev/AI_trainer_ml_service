          "title": "Correlation Id"
        },
        "provider_attempts": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Attempts"
        }
      },
      "title": "MLErrorDetails[Literal['interviewer']]",
      "type": "object"
    },
    "InterviewerErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/MLErrorBody_Literal__interviewer___"
        },
        "meta": {
          "$ref": "#/$defs/MLResponseMeta"
        }
      },
      "required": [
        "error"
      ],
      "title": "MLErrorResponse[Literal['interviewer']]",
      "type": "object"
    }
  }
