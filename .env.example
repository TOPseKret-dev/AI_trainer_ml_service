# Copy to .env and fill in the key before starting Docker Compose.
# Compose only forwards the explicitly listed application variables.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-27b
OPENROUTER_PROVIDER=alibaba
OPENROUTER_TIMEOUT_SECONDS=55

# Total LLM budget, including the optional repair attempt; maximum 55 seconds.
# Per-request deadline_at can shorten this budget with a 5-second Core reserve.
# Keep the Core Backend HTTP timeout above this value (e.g. 60 seconds).
LLM_REQUEST_TIMEOUT_SECONDS=55

# Container settings. Port inside Docker is always 8001.
ML_IMAGE=intersim-ml:local
ML_HOST_PORT=8001
ML_WORKERS=1
ML_CONCURRENCY=32
ML_LOG_LEVEL=info
ML_CPUS=1.0
ML_MEMORY_LIMIT=512m
ML_TMPFS_SIZE=128m
ML_SHUTDOWN_TIMEOUT_SECONDS=60
ML_STOP_GRACE_PERIOD=75s

# Standalone Compose creates this network.
ML_NETWORK_NAME=intersim-ml
# With compose.intersim.yaml, set the actual existing Core Backend network name.
# Find it with: docker inspect intersim_backend --format '{{json .NetworkSettings.Networks}}'
INTERSIM_NETWORK=intersim_intersim_internal

# Required only for ASR. Keep ML_WORKERS=1 for the bounded ASR queue.
ASR_GROQ_API_KEY=

# Autonomous question generation only; Interviewer/Evaluator keep their own settings.
# Optional separate key; empty uses OPENROUTER_API_KEY. Never sent by the admin form.
QUESTIONGEN_API_KEY=
QUESTIONGEN_MAX_CONCURRENT=1
QUESTIONGEN_POLICY__MAX_COST_USD=1.0
QUESTIONGEN_POLICY__DEADLINE_SECONDS=900
QUESTIONGEN_POLICY__CALL_TIMEOUT_SECONDS=90
# Local runs use this private directory. Compose supplies its persistent volume path.
QUESTIONGEN_STATE_DIR=artifacts/question-generation
